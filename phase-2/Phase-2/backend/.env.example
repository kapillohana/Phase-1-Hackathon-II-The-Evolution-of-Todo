# Environment variables for the backend
# For development, use SQLite (no server required)
DATABASE_URL=sqlite:///./todo_app.db

# For production with PostgreSQL, use:
# DATABASE_URL=postgresql://username:password@localhost:5432/todo_db

# For Neon DB, use (replace with your actual connection string):
# DATABASE_URL=postgresql://username:password@ep-xxxxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Security Configuration
SECRET_KEY=your-super-secret-and-long-key-here-at-least-32-characters-long-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=8000